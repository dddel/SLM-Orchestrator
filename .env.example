# Chiave API per Google AI Studio (Gemini)
GEMINI_API_KEY=INSERISCI_QUI_LA_TUA_CHIAVE_GOOGLE_AI_STUDIO

# Selezione Router (opzioni: 'gemini', 'jev', 'local-ollama')
ROUTER_TYPE=gemini

# Configurazione Jev (TypeSafe AI)
# JEV_PROVIDER=typesafe
JEV_API_KEY=INSERISCI_QUI_LA_TUA_CHIAVE_TYPESAFE_AI
# JEV_MODEL=jev-latest

# In alternativa, per Cloudflare Workers AI (Clef):
# ROUTER_TYPE=jev
# JEV_PROVIDER=cloudflare
# CLOUDFLARE_API_TOKEN=INSERISCI_QUI_IL_TUO_TOKEN_CLOUDFLARE
# CLOUDFLARE_ACCOUNT_ID=INSERISCI_QUI_ACCOUNT_ID
# JEV_MODEL=@cf/cloudflare/clef-flash

# Configurazione endpoint Ollama (default compose: http://ollama:11434; host locale: http://host.containers.internal:11434 o http://localhost:11434)
OLLAMA_BASE_URL=http://ollama:11434
